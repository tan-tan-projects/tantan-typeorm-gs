{
  "name": "tantan-typeorm-gs",
  "version": "1.0.5-beta.7",
  "description": "A TypeORM-compatible driver for using Google Sheets as a data source.",
  "repository": {
    "type": "git",
    "url": "https://github.com/tan-tan-projects/tantan-typeorm-gs.git"
  },
  "bugs": {
    "url": "https://github.com/tan-tan-projects/tantan-typeorm-gs/issues"
  },
  "homepage": "https://github.com/tan-tan-projects/tantan-typeorm-gs#readme",
  "keywords": [
    "typeorm",
    "google-sheets",
    "google-sheets-api",
    "typeorm-driver",
    "typeorm-driver-google-sheets",
    "database",
    "orm",
    "typescript",
    "bun"
  ],
  "module": "src/index.ts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
