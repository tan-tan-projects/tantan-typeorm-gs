{
  "name": "tantan-typeorm-gs",
  "version": "1.0.0",
  "description": "A TypeORM-compatible driver for using Google Sheets as a data source.",
  "keywords": [
    "typeorm",
    "google-sheets",
    "google-sheets-api",
    "typeorm-driver",
    "typeorm-driver-google-sheets",
    "database",
    "orm",
    "typescript",
    "bun"
  ],
  "module": "src/index.ts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:run": "bun test"
  },
  "dependencies": {
    "googleapis": "^178.0.0",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}