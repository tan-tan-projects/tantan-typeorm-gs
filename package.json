    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:run": "bun test"
  },
  "dependencies": {
    "googleapis": "^178.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typeorm": "^1.1.1"
  },
  "peerDependencies": {
    "typeorm": "^1.1.1",
    "typescript": "^7"
  }
}
