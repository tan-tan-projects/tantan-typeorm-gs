{
	"extends": "./tsconfig.json",

	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",

		"noEmit": false,

		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,

		"outDir": "./dist",
		"rootDir": "./src",

		"allowImportingTsExtensions": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "test"]
}
